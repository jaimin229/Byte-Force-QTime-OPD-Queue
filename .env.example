# ==========================================
# QTime Live OPD Queue Environment Template
# ==========================================

# --- Supabase Core Engine ---
# Your Supabase Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous API Key (safe for client-side and mobile apps)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret Service Role Key (SERVER/CLI ONLY - NEVER expose in client apps)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# PostgreSQL Database Connection Password
SUPABASE_DB_PASSWORD=your-database-password-here

# --- Firebase Services (Optional - Mobile FCM Push Notifications) ---
# Project ID from Firebase Console
FIREBASE_PROJECT_ID=pushup-pro-oath

# Web Push VAPID Key / FCM Server Token
FIREBASE_VAPID_KEY=your-firebase-vapid-key-here

# --- Google Cloud Platform (Optional - Hospital BigQuery Telemetry) ---
# GCP Project ID for telemetry and audit log streaming
GCP_PROJECT_ID=pushup-pro-oath
GCP_REGION=asia-south1

# --- Hospital OPD Configuration ---
DEFAULT_CONSULT_SECS=420
AWAY_ALERT_PATIENTS_THRESHOLD=5
ETA_REFRESH_INTERVAL_MS=15000
